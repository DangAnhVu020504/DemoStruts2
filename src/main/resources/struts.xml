<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
        "http://struts.apache.org/dtds/struts-2.5.dtd">

<struts>
    <package name="default" namespace="/" extends="struts-default">

        <!-- Trang chủ -->
        <action name="home" class="com.example.action.HomeAction">
            <result name="success">/home.jsp</result>
            <result name="error">/error.jsp</result>
        </action>

        <!-- Đăng nhập -->
        <action name="login" class="com.example.action.LoginAction">
            <result name="success">/home.jsp</result>
            <result name="input">/login.jsp</result>
            <result name="error">/error.jsp</result>
        </action>

        <!-- Đăng ký -->
        <action name="register" class="com.example.action.RegisterAction">
            <result name="success">/login.jsp</result>
            <result name="input">/register.jsp</result>
        </action>

        <!-- Đăng xuất -->
        <action name="logout" class="com.example.action.LogoutAction">
            <result name="success">/login.jsp</result>
        </action>

        <!-- Tạo bài viết -->
        <action name="createPost" class="com.example.action.CreatePostAction">
            <result name="home" type="redirectAction">home</result> <!-- Chuyển hướng đến action "home" -->
            <result name="input">/createPost.jsp</result>
            <result name="error">/error.jsp</result>
        </action>

        <!-- Xóa bài viết -->
        <action name="deletePost" method="deletePost" class="com.example.action.HomeAction">
            <result name="success">/home.jsp</result>
            <result name="error">/error.jsp</result>
        </action>
    </package>
</struts>